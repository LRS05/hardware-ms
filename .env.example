CONFIG_SERVER_URL=http://config-server:8888
CONFIG_DATA_LOCATION=file:/config-data/
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

POSTGRES_USER=hardware
POSTGRES_PASSWORD=change-me-postgres
USER_DB_URL=jdbc:postgresql://postgres:5432/user_db
PRODUCT_DB_URL=jdbc:postgresql://postgres:5432/product_db
ORDER_DB_URL=jdbc:postgresql://postgres:5432/order_db

JWT_SECRET_KEY=dev-only-jwt-secret-change-before-deploying-0123456789-abcdefghijklmnopqrstuvwxyz
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=86400000

PRODUCT_SERVICE_API_KEY=change-me-product-api-key
ORDER_SERVICE_API_KEY=change-me-order-api-key
PAYMENT_SERVICE_API_KEY=change-me-payment-api-key
