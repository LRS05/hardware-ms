{
	"info": {
		"_postman_id": "3cf54b5a-6219-46e7-a4f4-c800b957b630",
		"name": "Hardware API - Demo",
		"description": "Set the collection credentials and run the top-level requests in order through the gateway. After creating the product, copy its id to productId. Stock should change from 10 to 9 after checkout and return to 10 after reopening. Use login cookies. For another run, change the customer username, email and product SKU. Run the Mercado Pago - Demo folder separately after the main demo; follow its instructions for test payment and automatic order completion. Check for environment variables overriding collection values.",
		"schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
		"_exporter_id": "40436462"
	},
	"item": [
		{
			"name": "Login as admin",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/v1/auth/login"
			},
			"response": []
		},
		{
			"name": "Get own profile (admin)",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/admin/me"
			},
			"response": []
		},
		{
			"name": "Create product",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"ACTIVE\",\n  \"category\": \"RAM_MEMORY\",\n  \"sku\": \"RAM-TEST-001\",\n  \"name\": \"Memoria RAM de prueba\",\n  \"description\": \"Sample RAM module for the API demonstration.\",\n  \"price\": 100,\n  \"stock\": 10\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/v1/admin/products"
			},
			"response": []
		},
		{
			"name": "Get products",
			"request": {
