{
	"info": {
		"_postman_id": "13ff6c8e-4523-40d5-9216-71c597a20146",
		"name": "Hardware API - Demo",
		"schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
		"_exporter_id": "40436462",
		"description": "Set the collection credentials and run requests in order through the gateway. After creating the product, copy its id to productId. Stock should change from 10 to 9 after checkout and return to 10 after reopening. Use login cookies. For another run, change the customer username, email and product SKU. Check for environment variables overriding collection values."
	},
	"item": [
		{
			"name": "Login as admin",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/v1/auth/login"
			},
			"response": []
		},
		{
			"name": "Create product",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"ACTIVE\",\n  \"category\": \"RAM_MEMORY\",\n  \"sku\": \"RAM-TEST-001\",\n  \"name\": \"Memoria RAM de prueba\",\n  \"description\": \"Sample RAM module for the API demonstration.\",\n  \"price\": 100,\n  \"stock\": 10\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/v1/admin/products"
			},
			"response": []
		},
		{
			"name": "Get products",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/products"
			},
			"response": []
		},
		{
			"name": "Register customer",
			"protocolProfileBehavior": {
				"disableCookies": false
			},
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"customer@example.com\",\n    \"username\": \"{{customerUsername}}\",\n    \"password\": \"{{customerPassword}}\",\n    \"first_name\": \"Demo\",\n    \"last_name\": \"Customer\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/v1/auth/register"
			},
			"response": []
		},
		{
			"name": "Login customer",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{customerUsername}}\",\n    \"password\": \"{{customerPassword}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/v1/auth/login"
			},
			"response": []
		},
		{
			"name": "Get own profile (customer)",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/users/me"
			},
			"response": []
		},
		{
			"name": "Add product to order",
			"request": {
				"method": "PATCH",
				"header": [],
				"url": "{{baseUrl}}/api/v1/orders/active/items/products/{{productId}}"
			},
			"response": []
		},
		{
			"name": "Get order",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/orders/active"
			},
			"response": []
		},
		{
			"name": "Checkout order",
			"request": {
				"method": "PATCH",
				"header": [],
				"url": "{{baseUrl}}/api/v1/orders/active/checkout"
			},
			"response": []
		},
		{
			"name": "Get pending order",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/orders/pending"
			},
			"response": []
		},
		{
			"name": "Get product",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/products/{{productId}}"
			},
			"response": []
		},
		{
			"name": "Reopen order",
			"request": {
				"method": "PATCH",
				"header": [],
				"url": "{{baseUrl}}/api/v1/orders/pending/reopen"
			},
			"response": []
		},
		{
			"name": "Get reopened cart",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/orders/active"
			},
			"response": []
		},
		{
			"name": "Verify restored stock",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/products/{{productId}}"
			},
			"response": []
		}
	],
